# Import necessary libraries
from src.pretrained_feature_extractor import PretrainedFeatureExtractor
import numpy as np
import matplotlib.pyplot as plt

# Initialize Feature Extractor
feature_extractor = PretrainedFeatureExtractor(model_name="resnet18", device="cuda")

# Extract Features
image_folder = "./data/input_images"
features = feature_extractor.extract_features(image_folder)

# Save Features
np.save("./data/extracted_features/features.npy", features)

# Visualize Features (e.g., using t-SNE)
from sklearn.manifold import TSNE

tsne = TSNE(n_components=2, random_state=42)
reduced_features = tsne.fit_transform(features)

plt.scatter(reduced_features[:, 0], reduced_features[:, 1], alpha=0.5)
plt.title("Feature Visualization with t-SNE")
plt.show()
