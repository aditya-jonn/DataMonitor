# =============================================================================
# datamonitor.sh — environment configuration
# =============================================================================
# Copy this file to `.env` next to datamonitor.sh, then edit. The script
# auto-loads it via `set -a; source .env; set +a`, so:
#
#   * Every assignment here is EXPORTED to the script's environment.
#   * Values in .env OVERRIDE anything already in the shell environment.
#     I.e. .env wins over command-line env vars. To change a setting for one
#     run, edit .env (or comment a line out to fall back to the script's
#     internal default).
#
# Lines starting with `#` are comments. Values with spaces or special
# characters need quotes ("value with spaces"). No spaces around the `=`.
# =============================================================================



# =============================================================================
# Activating environment

#module load miniconda3
#which conda                              # confirm it's now on PATH

#PYTHON_BIN=/home/aditya.jonnalagadda/.conda/envs/dm-py38/bin/python3.8

#conda create -n dm-py38 python=3.8 -y --solver=classic

#conda activate dm-py38
#which python3.8

# =============================================================================


# -----------------------------------------------------------------------------
# WHICH STAGES TO RUN (1 = run, 0 = skip)
# -----------------------------------------------------------------------------
# The full pipeline is:  setup → train → extract → eval
# Skipped stages still activate the venv if it exists.

RUN_SETUP="${RUN_SETUP:-1}"     # create venv, install deps, patch broken imports, write cfg.json
RUN_TRAIN="${RUN_TRAIN:-1}"     # train autoencoder, supervised-cnn, supervised-ctr (slow)
RUN_EXTRACT="${RUN_EXTRACT:-1}"   # dump features from the three checkpoints
RUN_EVAL="${RUN_EVAL:-1}"      # bootstrap Table 3 + CUSUM Figure 3


# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
# Where the DataMonitor repo lives. Defaults to the directory containing
# datamonitor.sh, which is almost always what you want. Leave commented
# unless you're running the script from outside the repo.
#REPO_DIR=/path/to/DataMonitor-main

# Where the venv lives. Default is $REPO_DIR/.venv-py38.
VENV_DIR=./venv-py311

# Where MedMNIST .npz files live (organ{a,c,s}mnist.npz).
# For author-reproduction on the original machine:
DATA_DIR=data

# Where the trained .pt checkpoints live. The author has these pretrained
# from the paper run; pointing here + RUN_TRAIN=0 skips ~hours of training.
MODEL_SAVES_DIR=model_saves

# Where to write the bootstrap CSV (Table 3) and figures (Figure 3).
# Default to $REPO_DIR/results and $REPO_DIR/figures.
#RESULTS_DIR=/path/to/results
#FIGURES_DIR=/path/to/figures
#NUMPY_FILES_DIR=/path/to/numpy_files


# -----------------------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------------------
# The committed requirements.lock.txt pins torch 2.6 / numpy 2.x, resolved for
# Python 3.11. PYTHON_BIN must point at a 3.11 interpreter (venv is ./venv-py311).

PYTHON_BIN=python3

# Optional: if `python3.8 -m venv` is unavailable on your host (some HPC
# nodes ship Python without ensurepip), download virtualenv.pyz once and
# uncomment this:
#   wget https://bootstrap.pypa.io/virtualenv.pyz
VIRTUALENV_PYZ=/home/kenny.cha/virtualenv/virtualenv.pyz


# -----------------------------------------------------------------------------
# TRAINING HYPERPARAMETERS
# -----------------------------------------------------------------------------
# These match the upstream bash_scripts/*_runner.sh defaults (= paper
# Table 5-7). Drop EPOCHS to e.g. 5 for a quick smoke test.

EPOCHS="${EPOCHS:-100}"
BATCH_SIZE="${BATCH_SIZE:-128}"
LEARNING_RATE=0.001

# Random seed (also names model_saves/bsz<BS>_seed<SEED>).
DM_SEED="${DM_SEED:-2008}"

DM_NUM_WORKERS="${DM_NUM_WORKERS:-6}"   # dataloader workers per training pipeline
OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}" # cap each pipeline's BLAS threads

# Which view is in-distribution.
# Options: organamnist (axial, paper default)
#          organcmnist (coronal)
#          organsmnist (sagittal)
POSITIVE_DATASET=organamnist

# Set to 1 to retrain even if a checkpoint already exists in MODEL_SAVES_DIR.
FORCE_TRAIN="${FORCE_TRAIN:-0}"

# Flush Python output immediately so logs update per epoch, not per process
PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"

# -----------------------------------------------------------------------------
# EVALUATION
# -----------------------------------------------------------------------------
# Number of bootstrap resamples for Table 3 (paper used 100).
BOOTSTRAP_N="${BOOTSTRAP_N:-1000}"


# -----------------------------------------------------------------------------
# HARDWARE
# -----------------------------------------------------------------------------
# Comma-separated CUDA device IDs. Leave empty for all available GPUs (or CPU).
# Example: USE_GPUS=0,1   →   CUDA_VISIBLE_DEVICES=0,1
USE_GPUS="${USE_GPUS:-0}"


# -----------------------------------------------------------------------------
# EXPLICIT CHECKPOINT PATHS (advanced — usually leave commented)
# -----------------------------------------------------------------------------
# By default the script auto-discovers checkpoints by picking the newest .pt
# in MODEL_SAVES_DIR whose name starts with the expected prefix. Override
# here if you want a specific checkpoint:
#
#AUTOENCODER_CKPT=/path/to/conv-autoencoder_<...>.pt
#CNN_CKPT=/path/to/supervised-cnn_<...>.pt
#CTR_CKPT=/path/to/supervised-ctr_<...>.pt


# =============================================================================
# EXAMPLE WORKFLOWS
# =============================================================================
# Copy ONE of these blocks over the values above (and comment out conflicting
# lines) to switch the .env to a different use case.
#
# ---------------------------------------------------------------------------
# Use case 1: I'm the paper's author. Pretrained ckpts, skip training.
# ---------------------------------------------------------------------------
#   RUN_SETUP=1
#   RUN_TRAIN=0
#   RUN_EXTRACT=1
#   RUN_EVAL=1
#   DATA_DIR=data
#   MODEL_SAVES_DIR=model_saves
#
# ---------------------------------------------------------------------------
# Use case 2: Fast smoke test on real data (5 epochs each, ~minutes)
# ---------------------------------------------------------------------------
#   EPOCHS=5
#   BOOTSTRAP_N=20
#   FORCE_TRAIN=1
#
# ---------------------------------------------------------------------------
# Use case 3: I already ran extract; only re-run the bootstrap with more samples
# ---------------------------------------------------------------------------
#   RUN_SETUP=0
#   RUN_TRAIN=0
#   RUN_EXTRACT=0
#   RUN_EVAL=1
#   BOOTSTRAP_N=500
